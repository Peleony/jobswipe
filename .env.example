# Optional: Jooble requests are server-side only. Keep real keys out of git.
JOOBLE_API_KEY=
# auto (default) or true: use demo offers only without a key; false: never use demo offers.
DEMO_DATA=auto
# Override only if Jooble provides a different endpoint for your key.
JOOBLE_API_BASE_URL=https://pl.jooble.org/api
# JobSwipe's conservative local allowance; official free-plan ceiling is 100 requests/key/UTC day.
JOOBLE_DAILY_REQUEST_LIMIT=90
# Each manual refresh is capped at 20 paginated requests (default 20).
JOOBLE_REQUESTS_PER_REFRESH=20
# Broad query; locations are queried in a fair round-robin across pages.
JOOBLE_KEYWORDS=praca
JOOBLE_LOCATIONS=Kraków,Warszawa,Wrocław,Polska
# Optional local override; relative to backend/. Default: backend/data/jobswipe.db.
# DATABASE_PATH=data/jobswipe.db
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
